{
  "name": "@example/dsh-plugin-hello",
  "version": "0.0.0",
  "description": "A DeepSeek Harness plugin: one model-facing tool and one system-prompt section",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "clean": "rm -rf lib *.tsbuildinfo",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.json",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "pack:bundle": "pnpm run build && pnpm --filter ./bundle pack --pack-destination ..",
    "trace": "tsx scripts/dsh-trace.ts",
    "dsh:graph": "tsx scripts/dsh-graph.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "lefthook": "^2.1.9",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
